// Experiment 2: Demonstrates operations on a list of Person objects
void experiment02() {
	Person p1("Homer", 39);
	Person p2("Marge", 36);
	Person p3("Lisa", 10);

	DLinkedList<Person> plst;
	plst.push_back(p1);
	plst.push_back(p2);
	plst.push_back(p3);
	plst.showList("After inserting three people");

	Node<Person>* ptr = plst.find(Person("Marge"));
	cout << "Pointer returned when searching for Marge " << ptr << endl;
	cout << "Dereferencing the pointer: \n" << *ptr << endl;

	plst.push_front(Person("Maggie", 1));
	plst.showList("After adding Maggie to the front");

	cout << "Show front node => " << plst.front() << endl;

	ptr = plst.find(Person("Lisa"));
	plst.insert(ptr, Person("Bart", 10));
	plst.showList("After adding Bart in front of Lisa");

	deleteflag = true; // Enable flag to show memory cleanup
}

